---
import fs from 'fs';
import path from 'path';

let pageData = {
  lastUpdated: new Date().toISOString(),
  articles: [],
};

try {
  const dataPath = path.resolve('./src/data/projected-matchups.json');
  if (fs.existsSync(dataPath)) {
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    pageData = JSON.parse(rawData);
  }
} catch (error) {
  console.error('Error loading data:', error);
}

const articles = pageData.articles || [];
const heroImages = pageData.heroImages || { fighters: [], analytics: null };
const matchups = pageData.matchups || [];
const rankings = pageData.rankings || {};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projected Matchups | Fightonomics</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f0f0f; color: #fff; line-height: 1.6; }
    .container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
    header { text-align: center; margin-bottom: 50px; border-bottom: 2px solid #ff6b35; padding-bottom: 30px; }
    h1 { font-size: 3em; margin-bottom: 12px; color: #ff6b35; text-transform: uppercase; letter-spacing: 2px; }
    .tagline { font-size: 1.1em; color: #aaa; margin-bottom: 20px; }
    .back-link { color: #ff6b35; text-decoration: none; font-size: 0.95em; margin-top: 15px; display: inline-block; }
    .back-link:hover { text-decoration: underline; }
    .hero-section { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 50px; padding-bottom: 30px; border-bottom: 2px solid #333; }
    .hero-image { width: 100%; height: 250px; border-radius: 8px; overflow: hidden; border: 2px solid #ff6b35; }
    .hero-image img { width: 100%; height: 100%; object-fit: cover; }
    .hero-label { color: #ff6b35; font-size: 0.85em; text-transform: uppercase; letter-spacing: 1px; margin-top: 8px; text-align: center; font-weight: 600; }
    
    .matchups-section { margin-bottom: 60px; }
    .matchups-section h2 { font-size: 2em; color: #ff6b35; margin-bottom: 30px; text-align: center; text-transform: uppercase; }
    
    .division-matchups { margin-bottom: 50px; }
    .division-title { font-size: 1.3em; color: #fff; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #ff6b35; }
    
    .matchup-card { 
      background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
      border: 2px solid #ff6b35;
      border-radius: 8px;
      padding: 25px;
      margin-bottom: 20px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 30px;
      align-items: center;
    }
    
    .fighter-info {
      text-align: center;
      padding: 15px;
      background: #0f0f0f;
      border-radius: 6px;
    }
    
    .fighter-rank { color: #ff6b35; font-size: 0.8em; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
    .fighter-name { font-size: 1.3em; font-weight: 600; margin: 10px 0; }
    .fighter-record { color: #aaa; font-size: 0.9em; }
    
    .vs-divider { 
      text-align: center;
      font-size: 1.5em;
      font-weight: bold;
      color: #ff6b35;
    }
    
    .matchup-type { 
      position: absolute;
      top: 10px;
      right: 15px;
      background: #ff6b35;
      color: #000;
      padding: 5px 12px;
      border-radius: 4px;
      font-size: 0.8em;
      font-weight: 600;
    }
    
    .matchup-card { position: relative; }
    
    .articles { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 30px; margin-top: 40px; }
    article { background: #1a1a1a; border: 1px solid #333; border-radius: 4px; overflow: hidden; transition: all 0.3s ease; }
    article:hover { border-color: #ff6b35; box-shadow: 0 0 20px rgba(255, 107, 53, 0.2); }
    .article-image { width: 100%; height: 220px; background: #2a2a2a; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .article-image img { width: 100%; height: 100%; object-fit: cover; }
    .article-content { padding: 20px; }
    .article-source { font-size: 0.75em; color: #ff6b35; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-weight: 600; }
    h3 { font-size: 1.2em; margin-bottom: 12px; line-height: 1.4; color: #fff; }
    .article-description { font-size: 0.95em; color: #ccc; margin-bottom: 15px; line-height: 1.5; }
    .article-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 15px; border-top: 1px solid #333; }
    .article-date { font-size: 0.85em; color: #888; }
    a.read-more { color: #ff6b35; text-decoration: none; font-weight: 600; }
    a.read-more:hover { color: #ff8555; }
    .empty { text-align: center; padding: 60px 20px; color: #888; }
    .empty h2 { color: #ff6b35; margin-bottom: 10px; }
    @media (max-width: 768px) { 
      .hero-section { grid-template-columns: 1fr; }
      .matchup-card { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Projected Matchups</h1>
      <div class="tagline">Fight Predictions, Odds & Matchup Analysis</div>
      <a href="/fightonomics/mma-news/" class="back-link">← Back to Main News</a>
    </header>

    <div class="hero-section">
      {heroImages.fighters && heroImages.fighters[0] && (
        <div>
          <div class="hero-image">
            <img src={heroImages.fighters[0]} alt="Fighter" />
          </div>
          <div class="hero-label">Contender 1</div>
        </div>
      )}
      {heroImages.fighters && heroImages.fighters[1] && (
        <div>
          <div class="hero-image">
            <img src={heroImages.fighters[1]} alt="Fighter" />
          </div>
          <div class="hero-label">Contender 2</div>
        </div>
      )}
      {heroImages.analytics && (
        <div>
          <div class="hero-image">
            <img src={heroImages.analytics} alt="Analytics" />
          </div>
          <div class="hero-label">Matchup Stats</div>
        </div>
      )}
    </div>

    {matchups && matchups.length > 0 && (
      <div class="matchups-section">
        <h2>Top 5 Rankings By Division</h2>
        
        {Object.entries(rankings).map(([division, fighters]) => (
          <div class="division-matchups">
            <div class="division-title">{division}</div>
            {matchups
              .filter(m => m.division === division)
              .map((matchup) => (
                <div class="matchup-card">
                  <div class="matchup-type">{matchup.type}</div>
                  
                  <div class="fighter-info">
                    <div class="fighter-rank">#{matchup.fighter1.rank} Ranked</div>
                    <div class="fighter-name">{matchup.fighter1.name}</div>
                    <div class="fighter-record">{matchup.fighter1.record}</div>
                  </div>
                  
                  <div class="vs-divider">VS</div>
                  
                  <div class="fighter-info">
                    <div class="fighter-rank">#{matchup.fighter2.rank} Ranked</div>
                    <div class="fighter-name">{matchup.fighter2.name}</div>
                    <div class="fighter-record">{matchup.fighter2.record}</div>
                  </div>
                </div>
              ))}
          </div>
        ))}
      </div>
    )}

    {articles.length > 0 ? (
      <div class="articles">
        {articles.map((article) => (
          <article>
            <div class="article-image">
              {article.image && article.image.trim() !== '' ? (
                <img src={article.image} alt={article.title} loading="lazy" onerror="this.style.display='none'" />
              ) : null}
              {!article.image || article.image.trim() === '' ? (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2em;">🥊</div>
              ) : null}
            </div>
            <div class="article-content">
              <div class="article-source">{article.source}</div>
              <h3>{article.title}</h3>
              <p class="article-description">{article.description || 'Read the full story'}</p>
              <div class="article-footer">
                <span class="article-date">{new Date(article.publishedAt).toLocaleDateString()}</span>
                <a href={article.url} target="_blank" rel="noopener noreferrer" class="read-more">Read →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty">
        <h2>No matchup predictions available</h2>
        <p>Check back soon for fight predictions and odds</p>
      </div>
    )}

    {articles.length > 0 ? (
      <div class="articles">
        {articles.map((article) => (
          <article>
            <div class="article-image">
              {article.image && article.image.trim() !== '' ? (
                <img src={article.image} alt={article.title} loading="lazy" onerror="this.style.display='none'" />
              ) : null}
              {!article.image || article.image.trim() === '' ? (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2em;">🥊</div>
              ) : null}
            </div>
            <div class="article-content">
              <div class="article-source">{article.source}</div>
              <h2>{article.title}</h2>
              <p class="article-description">{article.description || 'Read the full story'}</p>
              <div class="article-footer">
                <span class="article-date">{new Date(article.publishedAt).toLocaleDateString()}</span>
                <a href={article.url} target="_blank" rel="noopener noreferrer" class="read-more">Read →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty">
        <h2>No matchup predictions available</h2>
        <p>Check back soon for fight predictions and odds</p>
      </div>
    )}
  </div>
</body>
</html>
