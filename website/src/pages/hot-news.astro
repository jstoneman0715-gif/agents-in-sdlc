---
import fs from 'fs';
import path from 'path';

let pageData = {
  lastUpdated: new Date().toISOString(),
  articles: [],
};

try {
  const dataPath = path.resolve('./src/data/hot-news.json');
  if (fs.existsSync(dataPath)) {
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    pageData = JSON.parse(rawData);
  }
} catch (error) {
  console.error('Error loading data:', error);
}

const articles = pageData.articles || [];
const heroImages = pageData.heroImages || { fighters: [], analytics: null };
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hot News This Week | Fightonomics</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f0f0f;
      color: #fff;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    header {
      text-align: center;
      margin-bottom: 50px;
      border-bottom: 2px solid #ff6b35;
      padding-bottom: 30px;
    }

    h1 {
      font-size: 3em;
      margin-bottom: 12px;
      color: #ff6b35;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .tagline {
      font-size: 1.1em;
      color: #aaa;
      margin-bottom: 20px;
    }

    .back-link {
      color: #ff6b35;
      text-decoration: none;
      font-size: 0.95em;
      margin-top: 15px;
      display: inline-block;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .hero-section {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 50px;
      padding-bottom: 30px;
      border-bottom: 2px solid #333;
    }

    .hero-image {
      width: 100%;
      height: 250px;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid #ff6b35;
    }

    .hero-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-label {
      color: #ff6b35;
      font-size: 0.85em;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 8px;
      text-align: center;
      font-weight: 600;
    }

    .articles {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: 30px;
      margin-bottom: 40px;
    }

    article {
      background: #1a1a1a;
      border: 1px solid #333;
      border-radius: 4px;
      overflow: hidden;
      transition: all 0.3s ease;
    }

    article:hover {
      border-color: #ff6b35;
      box-shadow: 0 0 20px rgba(255, 107, 53, 0.2);
    }

    .article-image {
      width: 100%;
      height: 220px;
      background: #2a2a2a;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .article-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .article-content {
      padding: 20px;
    }

    .article-source {
      font-size: 0.75em;
      color: #ff6b35;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
      font-weight: 600;
    }

    h2 {
      font-size: 1.2em;
      margin-bottom: 12px;
      line-height: 1.4;
      color: #fff;
    }

    .article-description {
      font-size: 0.95em;
      color: #ccc;
      margin-bottom: 15px;
      line-height: 1.5;
    }

    .article-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 15px;
      border-top: 1px solid #333;
    }

    .article-date {
      font-size: 0.85em;
      color: #888;
    }

    a.read-more {
      color: #ff6b35;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    a.read-more:hover {
      color: #ff8555;
    }

    .empty {
      text-align: center;
      padding: 60px 20px;
      color: #888;
    }

    .empty h2 {
      color: #ff6b35;
      margin-bottom: 10px;
    }

    @media (max-width: 768px) {
      .hero-section {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Hot News This Week</h1>
      <div class="tagline">Trending MMA Stories & Breaking Headlines</div>
      <a href="/fightonomics/mma-news/" class="back-link">← Back to Main News</a>
    </header>

    <div class="hero-section">
      {heroImages.fighters && heroImages.fighters[0] && (
        <div>
          <div class="hero-image">
            <img src={heroImages.fighters[0]} alt="Fighter" />
          </div>
          <div class="hero-label">Breaking Fighter News</div>
        </div>
      )}
      {heroImages.fighters && heroImages.fighters[1] && (
        <div>
          <div class="hero-image">
            <img src={heroImages.fighters[1]} alt="Fighter" />
          </div>
          <div class="hero-label">This Week's Highlights</div>
        </div>
      )}
      {heroImages.analytics && (
        <div>
          <div class="hero-image">
            <img src={heroImages.analytics} alt="Analytics" />
          </div>
          <div class="hero-label">Hot Trends</div>
        </div>
      )}

    {articles.length > 0 ? (
      <div class="articles">
        {articles.map((article) => (
          <article>
            <div class="article-image">
              {article.image && article.image.trim() !== '' ? (
                <img 
                  src={article.image} 
                  alt={article.title}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              ) : null}
              {!article.image || article.image.trim() === '' ? (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2em;">
                  🔥
                </div>
              ) : null}
            </div>
            <div class="article-content">
              <div class="article-source">{article.source}</div>
              <h2>{article.title}</h2>
              <p class="article-description">{article.description || 'Read the full story'}</p>
              <div class="article-footer">
                <span class="article-date">{new Date(article.publishedAt).toLocaleDateString()}</span>
                <a href={article.url} target="_blank" rel="noopener noreferrer" class="read-more">Read →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty">
        <h2>No trending articles this week</h2>
        <p>Check back soon for hot news and breaking headlines</p>
      </div>
    )}
  </div>
</body>
</html>
